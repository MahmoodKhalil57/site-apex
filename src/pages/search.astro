---
// Static build: this page is prerendered to a single HTML file (no SSR). The
// query is read and results are fetched entirely on the client against the
// backend's search API. Because the deployed site is proxied so the static
// frontend and the EmDash backend share the origin (premium-cms.com), the
// fetch is a same-origin relative path: /_emdash/api/search?q=...
import Base from "../layouts/Base.astro";
---

<Base title="Search" description="Search blog posts">
	<section class="search-page">
		<h1 class="search-title">Search</h1>

		<form method="get" action="/search" class="search-form" data-search-form>
			<input
				type="search"
				name="q"
				placeholder="Search posts..."
				class="search-input"
				autofocus
				data-search-input
			/>
			<button type="submit" class="search-button">Search</button>
		</form>

		<p class="search-summary" data-search-summary hidden></p>

		<ol class="search-results" data-search-results hidden></ol>

		<p class="search-hint" data-search-hint>
			Enter a search term to find posts.
		</p>
	</section>
</Base>

<script>
	// Client-side search: read ?q= from the URL, query the backend's FTS-backed
	// search endpoint at runtime, and render results. Runs against the proxied
	// same-origin API, so no backend origin has to be baked in at build time.
	interface SearchItem {
		id?: string;
		slug?: string | null;
		title?: string | null;
		snippet?: string | null;
	}

	const form = document.querySelector<HTMLFormElement>("[data-search-form]");
	const input = document.querySelector<HTMLInputElement>("[data-search-input]");
	const summary = document.querySelector<HTMLElement>("[data-search-summary]");
	const list = document.querySelector<HTMLOListElement>("[data-search-results]");
	const hint = document.querySelector<HTMLElement>("[data-search-hint]");

	function escapeHtml(str: string): string {
		return str
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&apos;");
	}

	function render(query: string, results: SearchItem[]) {
		if (!summary || !list || !hint) return;

		if (!query) {
			hint.hidden = false;
			summary.hidden = true;
			list.hidden = true;
			list.innerHTML = "";
			return;
		}

		hint.hidden = true;
		summary.hidden = false;
		summary.textContent =
			results.length === 0
				? `No results for "${query}"`
				: `${results.length} result${results.length === 1 ? "" : "s"} for "${query}"`;

		if (results.length === 0) {
			list.hidden = true;
			list.innerHTML = "";
			return;
		}

		list.hidden = false;
		// Snippets returned by /api/search are already sanitised by the backend.
		list.innerHTML = results
			.map((result) => {
				const href = `/posts/${result.slug ?? result.id ?? ""}`;
				const title = escapeHtml(result.title ?? "Untitled");
				const snippet = result.snippet
					? `<p class="result-snippet">${result.snippet}</p>`
					: "";
				return `<li class="search-result"><a href="${href}" class="result-link"><h2 class="result-title">${title}</h2>${snippet}</a></li>`;
			})
			.join("");
	}

	async function runSearch(query: string) {
		if (!query) {
			render("", []);
			return;
		}
		try {
			const params = new URLSearchParams({
				q: query,
				collections: "posts",
				limit: "30",
			});
			const res = await fetch(`/_emdash/api/search?${params}`);
			if (!res.ok) throw new Error(`search failed: ${res.status}`);
			// Envelope: { success: true, data: { items: [...] } }
			const body = await res.json();
			const data = body.data ?? body;
			const items: SearchItem[] = data.items ?? data.results ?? [];
			render(query, items);
		} catch (err) {
			console.error(err);
			render(query, []);
		}
	}

	function currentQuery(): string {
		return new URL(window.location.href).searchParams.get("q")?.trim() ?? "";
	}

	// Hydrate from the URL on load.
	const initial = currentQuery();
	if (input) input.value = initial;
	document.title = initial ? `Search: ${initial}` : "Search";
	runSearch(initial);

	// Search without a full navigation; keep the URL shareable via history.
	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		const query = (input?.value ?? "").trim();
		const url = new URL(window.location.href);
		if (query) url.searchParams.set("q", query);
		else url.searchParams.delete("q");
		window.history.replaceState({}, "", url);
		document.title = query ? `Search: ${query}` : "Search";
		runSearch(query);
	});
</script>

<style>
	.search-page {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.search-title {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-6);
	}

	.search-form {
		display: flex;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-8);
	}

	.search-input {
		flex: 1;
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-base);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--color-brand);
	}

	.search-button {
		padding: var(--spacing-2) var(--spacing-6);
		font-size: var(--font-size-base);
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		font-weight: 500;
	}

	.search-button:hover {
		opacity: 0.9;
	}

	.search-summary {
		color: var(--color-muted);
		margin-bottom: var(--spacing-6);
	}

	.search-hint {
		color: var(--color-muted);
	}

	.search-results {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.search-result {
		padding: var(--spacing-6) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.search-result:first-child {
		padding-top: 0;
	}

	.search-result:last-child {
		border-bottom: none;
	}

	.result-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.result-title {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.result-link:hover .result-title {
		color: var(--color-brand);
	}

	.result-snippet {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	/* FTS returns <mark> wrapping the matched terms */
	.result-snippet :global(mark) {
		background: var(--color-brand-ring);
		color: inherit;
		padding: 0 0.1em;
		border-radius: 2px;
	}
</style>
